{
  "name": "bjff-book-locator",
  "private": true,
  "description": "Localizador de libros de la Biblioteca José Figueres Ferrer (TEC)",
  "scripts": {
    "postinstall": "pnpm --filter @bjff/classification build",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter bjff-book-locator-web dev",
    "test": "pnpm --filter @bjff/classification --filter api test",
    "build": "pnpm --filter @bjff/classification --filter api --filter bjff-book-locator-web build"
  },
  "packageManager": "pnpm@11.26.0"
}

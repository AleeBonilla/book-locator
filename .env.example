# Variables de docker-compose.prod.yaml. Se copia a .env (que no se versiona)
# en la raíz del repositorio, en el servidor.

# Contraseña de PostgreSQL. Solo letras y números, porque va dentro de
# DATABASE_URL. Para generar una: openssl rand -hex 24
POSTGRES_PASSWORD=

# Dónde escucha la web en el servidor. 8080 acepta conexiones de cualquier
# interfaz; 127.0.0.1:8080, solo de la propia máquina (p. ej. de un proxy
# inverso con HTTPS instalado en ella).
WEB_PORT=8080
